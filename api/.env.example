APP_NAME="Communaute Prions Ensemble"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Adresse de l'application cliente (PWA, puis Flutter par lien profond).
# Sert a construire les liens de reinitialisation de mot de passe.
FRONTEND_URL=http://localhost:8000

# Fuseau du public vise. La serie de jours consecutifs depend de la date du
# serveur : un fuseau faux decale les series de tous les membres.
APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------ journaux
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------ base de donnees
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ------------------------------------------------------------------- courriel
# Necessaire pour "mot de passe oublie". En local, "log" ecrit le message dans
# storage/logs/laravel.log au lieu de l'envoyer.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ne-pas-repondre@prionsensemble.ci"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------- CORS
# Origines autorisees a appeler l'API, separees par des virgules.
# En production : uniquement l'adresse de la PWA. Ne jamais laisser "*".
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------- stockage (R2)
# Photos de profil. Le disque local d'un hebergement gratuit est EPHEMERE :
# les fichiers disparaissent a chaque redemarrage. En production, mettre
# AVATAR_DISK=r2 et renseigner les cles Cloudflare R2 ci-dessous.
AVATAR_DISK=public

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# ----------------------------------------------------------------------- IA
# La cle vit ICI et nulle part ailleurs. Jamais dans le code, jamais dans Git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TIMEOUT=60
AI_DAILY_QUOTA=10

# ------------------------------------------------------- regles applicatives
PASTORAL_RESPONSE_DELAY_DAYS=7
PASTORAL_MAX_OPEN_QUESTIONS=3
READING_RESET_COOLDOWN_HOURS=24

VITE_APP_NAME="${APP_NAME}"
